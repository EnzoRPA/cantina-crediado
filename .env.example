# ============================================
# SISTEMA CANTINA ESCOLAR — Environment Config
# ============================================

# Server
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://cantina:cantina123@localhost:5432/cantina_escolar
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cantina_escolar
DB_USER=cantina
DB_PASSWORD=cantina123

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption (AES-256-GCM for biometric data)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# Mercado Pago
MP_ACCESS_TOKEN=your-mercado-pago-access-token
MP_PUBLIC_KEY=your-mercado-pago-public-key
MP_WEBHOOK_SECRET=your-webhook-secret

# InfinitePay
INFINITEPAY_HANDLE=your-infinitepay-tag-handle
INFINITEPAY_WORKER_URL=https://your-worker.workers.dev
INFINITEPAY_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-webhook-id

# Firebase Cloud Messaging
FCM_PROJECT_ID=your-firebase-project-id
FCM_PRIVATE_KEY=your-firebase-private-key
FCM_CLIENT_EMAIL=your-firebase-client-email

# MinIO (Object Storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=cantina-escolar

# WhatsApp Z-API (deferred)
# ZAPI_INSTANCE_ID=your-instance-id
# ZAPI_TOKEN=your-token
# ZAPI_SERVER_URL=https://api.z-api.io

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
